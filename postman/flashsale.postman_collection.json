{
  "info": {
    "name": "FlashSale Service",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Start the stack with `docker compose up -d --wait`, then run the folders in order (or the whole collection in the Runner)."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8088"
    },
    {
      "key": "password",
      "value": "Secret123"
    },
    {
      "key": "email",
      "value": ""
    },
    {
      "key": "otp",
      "value": ""
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "refreshToken",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "itemId",
      "value": ""
    },
    {
      "key": "scarceItemId",
      "value": ""
    },
    {
      "key": "productId",
      "value": ""
    },
    {
      "key": "sku",
      "value": ""

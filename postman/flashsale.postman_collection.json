        {
          "name": "Create draft slot",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/flash-sale/slots",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "admin",
                "flash-sale",
                "slots"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman slot\",\n  \"startAt\": \"{{slotStart}}\",\n  \"endAt\": \"{{slotEnd}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// A date 10+ days ahead so it never overlaps the 7-day demo calendar.",
                  "const days = 10 + Math.floor(Math.random() * 3000);",
                  "const d = new Date(Date.now() + days * 86400000);",
                  "const ymd = d.toISOString().slice(0, 10);",
                  "pm.collectionVariables.set('slotStart', `${ymd}T03:00:00Z`); // 10:00 Vietnam",
                  "pm.collectionVariables.set('slotEnd', `${ymd}T04:00:00Z`);   // 11:00 Vietnam"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('slotId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Add product to slot (quota 30)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/flash-sale/slots/{{slotId}}/items",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "admin",
                "flash-sale",
                "slots",
                "{{slotId}}",
                "items"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"{{productId}}\",\n  \"salePrice\": 990000,\n  \"quota\": 30\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {

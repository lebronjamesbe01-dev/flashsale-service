    {
      "name": "1. Auth",
      "description": "Full account lifecycle. A fresh email is generated, the OTP is read from the demo inbox, tokens are stored automatically.",
      "item": [
        {
          "name": "Register (email or phone)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "register"
              ]
            },
            "description": "Creates a PENDING account and sends an OTP. Same answer whether or not the identifier exists. A phone such as 0901234567 works too.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('email', `postman${Date.now()}@example.com`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 202', () => pm.response.to.have.status(202));"
                ]
              }
            }
          ]
        },
        {
          "name": "Read OTP from demo inbox",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/demo/otp?identifier={{email}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",

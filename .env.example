# Copy to .env to override defaults. Every value has a working default in docker-compose.yml.
POSTGRES_DB=flashsale
POSTGRES_USER=flashsale
POSTGRES_PASSWORD=flashsale
RABBITMQ_USER=flashsale
RABBITMQ_PASSWORD=flashsale

# Host ports (change if they clash with something on your machine)
APP_PORT=8088
POSTGRES_PORT=15432
REDIS_PORT=16379
RABBITMQ_PORT=15673
RABBITMQ_UI_PORT=15672

# Demo profile + demo secrets. CHANGE ALL THREE outside a local demo: the default profile
# exposes the demo OTP lookup endpoint, and the default secrets are public in this repo.
# JWT_SECRET needs at least 32 characters.
SPRING_PROFILES_ACTIVE=demo
JWT_SECRET=compose-demo-jwt-secret-0123456789abcdefghij
OTP_HMAC_KEY=compose-demo-otp-hmac-key-0123456789abcdef

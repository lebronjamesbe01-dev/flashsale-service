# Copy to .env to override defaults. Every value has a working default in docker-compose.yml.
POSTGRES_DB=flashsale
POSTGRES_USER=flashsale
POSTGRES_PASSWORD=flashsale
RABBITMQ_USER=flashsale
RABBITMQ_PASSWORD=flashsale

# Host ports (change if they clash with something on your machine)
APP_PORT=8088
POSTGRES_PORT=15432
REDIS_PORT=16379
RABBITMQ_PORT=15673
RABBITMQ_UI_PORT=15672
